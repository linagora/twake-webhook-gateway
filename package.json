{
  "name": "twake-webhook-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "dev": "node --watch --env-file-if-exists=.env --import ./src/instrument.ts src/main.ts",
    "start": "node --import ./dist/instrument.js dist/main.js"
  },
  "dependencies": {
    "@linagora/rabbitmq-client": "^0.7.2",
    "@linagora/twake-node-server": "^1.0.1",
    "@sentry/node": "^11.16.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "fastify": "^5.12.8",
    "openid-client": "^6.9.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
